{
  "name": "tokensafe",
  "version": "4.2.3",
  "description": "Your coding agent isn't getting dumber. Your context is just full of trash. Local context firewall & zero-loss runtime for Cursor, Claude Code, and autonomous agents.",
  "homepage": "https://tokensafe.dev",
  "license": "MIT",
  "logo": "https://tokensafe.dev/logo.png",
  "icon": "https://tokensafe.dev/logo.png",
  "iconUrl": "https://tokensafe.dev/logo.png",
  "author": {
    "name": "TokenSafe"
  },
  "interface": {
    "displayName": "TokenSafe",
    "shortDescription": "Stop coding agent context rot, destructive rewrites & secret leaks",
    "developerName": "TokenSafe",
    "websiteURL": "https://tokensafe.dev",
    "logo": "https://tokensafe.dev/logo.png",
    "iconUrl": "https://tokensafe.dev/logo.png"
  },
  "skills": [
    "skills/token-optimizer"
  ],
  "mcpServers": {
    "tokensafe": {
      "command": "python3",
      "args": [
        "src/mcp_server.py"
      ]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Write",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Read",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    }
  ]
}