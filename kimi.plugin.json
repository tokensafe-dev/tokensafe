{
  "name": "tokensafe",
  "version": "4.3.3",
  "description": "Your AI agent is smart enough to code all day. Now it actually can. Local runtime firewall & zero-loss context optimizer for AI coding agents.",
  "homepage": "https://tokensafe.dev",
  "license": "MIT",
  "logo": "https://tokensafe.dev/ts-logo-black-256.png",
  "icon": "https://tokensafe.dev/ts-logo-black-256.png",
  "iconUrl": "https://tokensafe.dev/ts-logo-black-256.png",
  "author": {
    "name": "TokenSafe"
  },
  "interface": {
    "displayName": "TokenSafe",
    "shortDescription": "Stop coding agent context rot, destructive rewrites & secret leaks",
    "developerName": "TokenSafe",
    "websiteURL": "https://tokensafe.dev",
    "logo": "https://tokensafe.dev/ts-logo-black-256.png",
    "iconUrl": "https://tokensafe.dev/ts-logo-black-256.png"
  },
  "skills": [
    "skills/token-optimizer"
  ],
  "mcpServers": {
    "tokensafe": {
      "command": "python3",
      "args": [
        "src/mcp_server.py"
      ]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Write",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Read",
      "command": "python3 hooks/kimi_hook.py",
      "timeout": 10
    }
  ]
}